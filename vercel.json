{
  "git": {
    "deploymentEnabled": false
  },
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "sila-fawn.vercel.app"
        }
      ],
      "destination": "https://www.silapadin.com/:path*",
      "statusCode": 301
    }
  ]
}
