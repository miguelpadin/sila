---
import { execSync } from 'node:child_process';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
import '../styles/global.css';

const commitHash = execSync('git rev-parse --short HEAD').toString().trim();
const commitDate = execSync('git log -1 --format=%cd').toString().trim();
const commitMsg  = execSync('git log -1 --format=%s').toString().trim();

type NavKey = 'servicios' | 'portafolio' | 'historias' | 'sobre-mi' | 'contacto';

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  bodyClass: string;
  currentPage?: NavKey;
  ogDescription?: string;
  ogImage?: string;
  ogImageAlt?: string;
  structuredData?: Record<string, unknown>;
  footerCopy?: string;
}

const SITE_URL = 'https://www.silapadin.com';
const DEFAULT_IMAGE = '/assets/inicio_01.webp';

const {
  title,
  description,
  canonicalPath,
  bodyClass,
  currentPage,
  ogDescription = description,
  ogImage = DEFAULT_IMAGE,
  ogImageAlt = 'Fotografía editorial de Sila Padín Studio',
  structuredData,
  footerCopy,
} = Astro.props;

const normalizedPath = canonicalPath === '/' ? '/' : `/${canonicalPath.replace(/^\/+/, '')}`;
const canonicalUrl = normalizedPath === '/' ? `${SITE_URL}/` : `${SITE_URL}${normalizedPath}`;
const absoluteOgImage = ogImage.startsWith('http') ? ogImage : `${SITE_URL}${ogImage}`;
const structuredDataJson = structuredData ? JSON.stringify(structuredData) : undefined;
---

<!doctype html>
<html lang="es">
  <head>
    <Fragment set:html={`<!-- Developed by Miguel Padín Domínguez — https://miguelpadin.github.io/ -->`} />
    <Fragment set:html={`<!-- Build: ${commitDate} | ${commitMsg} | ${commitHash} -->`} />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f2f0eb" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="es" href={canonicalUrl} />
    <link rel="alternate" hreflang="x-default" href={canonicalUrl} />
    <meta name="robots" content="index, follow" />
    <meta name="google-site-verification" content="zFIPJirS6GW_kkqUguT-o4aZhFF9hNtNBzhlnlMlgGI" />
    <meta name="author" content="Sila Padín" />

    <meta property="og:site_name" content="Sila Padín Studio" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:image" content={absoluteOgImage} />
    <meta property="og:image:alt" content={ogImageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={absoluteOgImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <link rel="icon" type="image/svg+xml" href="/assets/brand/favicon.svg" />
    <link rel="icon" type="image/png" href="/assets/brand/favicon.png" />
    <link rel="apple-touch-icon" href="/assets/brand/logo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&amp;family=Syne:wght@400;500;700;800&amp;display=swap"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&amp;family=Syne:wght@400;500;700;800&amp;display=swap"
        rel="stylesheet"
      />
    </noscript>

    {structuredDataJson && <script is:inline type="application/ld+json" set:html={structuredDataJson}></script>}
  </head>
  <body class={bodyClass}>
    <Header currentPage={currentPage} />
    <slot />
    <Footer footerCopy={footerCopy} />
    <CookieBanner />
    <script is:inline src="/main.js"></script>
  </body>
</html>
