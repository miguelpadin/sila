---
import '../styles/footer.scss';
import { version } from '../../package.json';

interface Props {
  footerCopy?: string;
}

const {
  footerCopy = 'Fotografía editorial, maternidad, branding y dirección visual para marcas con una estética limpia y luminosa.',
} = Astro.props;
---

<footer class="site-footer">
  <div class="wrap">
    <div class="site-footer-grid">
      <div>
        <a href="/" class="site-footer-brand">
          <img src="/assets/brand/logo.webp" alt="Sila Padín Studio" width="96" height="96" />
          <span>
            <strong>Sila Padín</strong>
            <small>Studio</small>
          </span>
        </a>
        <p class="site-footer-copy">{footerCopy}</p>
      </div>

      <nav class="site-footer-nav">
        <a href="/servicios.html">Servicios</a>
        <a href="/portafolio.html">Portafolio</a>
        <a href="/historias.html">Historias</a>
        <a href="/sobre-mi.html">Sobre mí</a>
        <a href="/contacto.html">Contacto</a>
      </nav>

      <div class="site-footer-contact">
        <a href="mailto:silapadin@gmail.com">silapadin@gmail.com</a>
        <a href="https://www.instagram.com/silapadinphotography" target="_blank" rel="noreferrer">Instagram</a>
        <a href="https://maps.app.goo.gl/iYZD1ci2Uhc4YxcQ9" target="_blank" rel="noreferrer">Galicia, España</a>
      </div>
    </div>

    <div class="site-footer-bottom">
      <nav class="site-footer-legal">
        <a href="/politica-de-privacidad.html">Política de privacidad</a>
        <a href="/politica-de-cookies.html">Política de cookies</a>
        <a href="/aviso-legal.html">Aviso legal</a>
      </nav>

      <div class="site-footer-meta">
        <span>© <span data-year></span> Sila Padín Studio</span>
        <span>Todos los derechos reservados.</span>
        <span>versión {version}</span>
      </div>
    </div>
  </div>
</footer>
