---
import BaseLayout from '../layouts/BaseLayout.astro';

const page = {
  "title": "Sila Padín Studio | Fotografía editorial y branding",
  "description": "Fotografía editorial, maternidad, retrato y dirección visual desde Galicia con una estética limpia, luminosa y atemporal.",
  "canonicalPath": "/",
  "bodyClass": "page-home",
  "ogDescription": "Fotografía editorial, maternidad, retrato y dirección visual desde Galicia con una estética limpia, luminosa y atemporal.",
  "ogImage": "/assets/inicio_01.webp",
  "ogImageAlt": "Sesión de maternidad exterior por Sila Padín Studio",
  "structuredData": {
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "name": "Sila Padín Studio",
    "description": "Fotógrafa y directora visual en Galicia especializada en maternidad, marca personal, lifestyle y bodas.",
    "url": "https://www.silapadin.com",
    "logo": "https://www.silapadin.com/assets/brand/logo.png",
    "image": "https://www.silapadin.com/assets/inicio_01.webp",
    "priceRange": "€€",
    "address": {
      "@type": "PostalAddress",
      "addressRegion": "Galicia",
      "addressCountry": "ES"
    },
    "sameAs": [
      "https://www.instagram.com/silapadin_photography"
    ],
    "founder": {
      "@type": "Person",
      "name": "Sila Padín",
      "jobTitle": "Fotógrafa y directora visual",
      "url": "https://www.silapadin.com/sobre-mi.html"
    }
  }
} as const;
---

<BaseLayout {...page}>
<main id="main-content">
      <section class="section hero reveal">
        <div class="wrap hero-grid">
          <div class="hero-intro">
            <p class="eyebrow">Estética atemporal</p>
            <h1>Momentos eternos capturados con <span>naturalidad</span>.</h1>
          </div>
          <div class="hero-copy">
            <p class="lead">
              Fotografía y dirección visual desde Galicia. Sesiones de marca personal, retrato, maternidad y lifestyle con una estética serena, luminosa y atemporal. Cada proyecto se construye desde la luz, el ritmo y los detalles que hacen que una historia visual merezca ser contada.
            </p>

            <div class="button-row">
              <a class="btn btn-solid" href="/contacto.html">Reservar sesión</a>
              <a class="btn btn-line" href="/portafolio.html">Ver portafolio</a>
            </div>

            <div class="hero-meta">
              <article>
                <strong>Galicia</strong>
                <span>con posibilidad de desplazamientos según proyecto</span>
              </article>
              <article>
                <strong>Sesiones</strong>
                <span>Marca personal · retrato · maternidad · lifestyle</span>
              </article>
              <article>
                <strong>Entrega</strong>
                <span>Selección y edición cuidadas, optimizadas para web, redes y uso editorial</span>
              </article>
            </div>
          </div>
        </div>
      </section>

      <section class="section reveal">
        <div class="wrap">
          <div class="section-head">
            <div>
              <p class="eyebrow">Selección</p>
              <h2>El arte de contar historias</h2>
            </div>
            <p>
              Cada proyecto se construye desde la luz, el ritmo y los detalles. La idea no es
              producir imágenes bonitas sin más, <br>sino crear una narrativa visual que permanezca.
            </p>
          </div>

          <div class="feature-grid">
            <article class="feature-card">
              <figure>
                <img decoding="async"
                   src="/assets/seleccion_01.webp"
                  alt="Retrato exterior de una mujer embarazada en una sesión de maternidad"
                  loading="lazy" width="820" height="1069"
                />
              </figure>
              <div class="feature-card-body">
                <p class="card-kicker">Maternidad</p>
                <h3>Luz suave, presencia real</h3>
                <p>
                  Sesiones que acompañan la calma del momento y dejan espacio para la emoción sin
                  artificios.
                </p>
              </div>
            </article>

            <article class="feature-card">
              <figure>
                <img decoding="async"
                   src="/assets/seleccion_02.webp"
                  alt="Detalle de sesión fotográfica"
                  loading="lazy" width="533" height="800"
                />
              </figure>
              <div class="feature-card-body">
                <p class="card-kicker">Detalles</p>
                <h3>Gestos pequeños que sostienen la escena</h3>
                <p>
                  Primeros planos, texturas y objetos que aportan silencio, respiración y carácter
                  a la historia.
                </p>
              </div>
            </article>

            <article class="feature-card">
              <figure>
                <img decoding="async"
                   src="/assets/seleccion_03.webp"
                  alt="Fotografía de marca editorial"
                  loading="lazy" width="533" height="800"
                />
              </figure>
              <div class="feature-card-body">
                <p class="card-kicker">Marca</p>
                <h3>Imagen editorial para proyectos con identidad</h3>
                <p>
                  Contenido pensado para web, redes y campañas que necesitan coherencia estética y
                  dirección visual.
                </p>
              </div>
            </article>
          </div>
        </div>
      </section>

      <section class="section reveal">
        <div class="wrap">
          <div class="quote-panel">
            <blockquote>
              “La fotografía es el único lenguaje capaz de detener un gesto y dejarlo respirar.”
            </blockquote>
            <p>Una mirada editorial para escenas íntimas, marcas sensibles y momentos irrepetibles.</p>
          </div>
        </div>
      </section>

      <section class="section reveal">
        <div class="wrap">
          <div class="checklist-panel">
            <div class="section-head compact">
              <div>
                <p class="eyebrow">Servicios exclusivos</p>
                <h2>Una experiencia cuidada de principio a fin</h2>
              </div>
            </div>

            <div class="checklist">
              <article class="check-item">
                <h3>Dirección visual coherente</h3>
                <p>
                  Definimos intención, referencias, estilismo y ritmo para que toda la sesión se
                  sienta unificada.
                </p>
              </article>
              <article class="check-item">
                <h3>Sesiones pensadas para marca y emoción</h3>
                <p>
                  Trabajo con retrato, maternidad, contenido editorial y piezas visuales para
                  marcas personales.
                </p>
              </article>
              <article class="check-item">
                <h3>Entrega preparada para publicar</h3>
                <p>
                  Recibes una selección final en alta calidad, optimizaciones para web, redes y usos
                  editoriales sin perder la naturalidad.
                </p>
              </article>
            </div>

            <div class="button-row">
              <a class="btn btn-solid" href="/servicios.html">Ver servicios</a>
              <a class="btn btn-line" href="/contacto.html">Pedir propuesta</a>
            </div>
          </div>

          <div class="poster-card" style="margin-top: 4rem;">
            <div class="poster-inner">
              <img decoding="async"  src="/assets/brand/logo.webp" alt="Logo de Sila Padín Studio" loading="lazy" width="480" height="480" />
              <p class="poster-caption">Dirección visual, fotografía y edición con una estética limpia.</p>
            </div>
          </div>
        </div>
      </section>

      <section class="section reveal">
        <div class="wrap">
          <div class="cta-banner">
            <div>
              <p class="eyebrow on-dark">Contacto</p>
              <h2>¿Lista para contar tu historia?</h2>
              <p>
                Cuéntame qué estás imaginando y preparamos una propuesta a medida, sencilla y con
                dirección clara desde el principio.
              </p>
            </div>
            <div class="button-row">
              <a class="btn btn-solid-light" href="/contacto.html">Escríbeme</a>
              <a
                class="btn btn-dark-line"
                href="https://www.instagram.com/silapadinphotography"
                target="_blank"
                rel="noreferrer"
                >Instagram</a
              >
            </div>
          </div>
        </div>
      </section>
    </main>
</BaseLayout>
