---
import '../styles/portfolio.scss';
import BaseLayout from '../layouts/BaseLayout.astro';

const page = {
  "title": "Portafolio | Sila Padín Studio",
  "description": "Selección de sesiones de maternidad, marca, lifestyle y detalles con una dirección visual limpia y editorial.",
  "canonicalPath": "/portafolio.html",
  "bodyClass": "page-portfolio",
  "currentPage": "portafolio",
  "ogImage": "/assets/seleccion_03.webp",
  "ogImageAlt": "Portafolio de fotografía de Sila Padín Studio"
} as const;
---

<BaseLayout {...page}>
<main id="main-content">
      <section class="section reveal">
        <div class="wrap page-hero">
          <div>
            <p class="eyebrow">Selección visual</p>
            <h1 class="page-title">Portafolio</h1>
          </div>
          <p class="page-intro">
            Una colección de imágenes donde conviven maternidad, producto, detalle y lifestyle. La
            idea es explorar cómo la luz y la composición pueden construir calma incluso dentro de
            escenas cotidianas.
          </p>
        </div>
      </section>

      <section class="section reveal">
        <div class="wrap">
          <div class="filter-bar" aria-label="Filtros del portafolio">
            <button class="filter-btn is-active" type="button" data-filter="marca" aria-pressed="true">Marca</button>
            <button class="filter-btn" type="button" data-filter="branding" aria-pressed="false">Branding y social media</button>
            <button class="filter-btn" type="button" data-filter="maternidad" aria-pressed="false">Maternidad</button>
            <button class="filter-btn" type="button" data-filter="lifestyle" aria-pressed="false">Lifestyle</button>
            <button class="filter-btn" type="button" data-filter="bodas" aria-pressed="false">Bodas</button>
            <button class="filter-btn" type="button" data-filter="all" aria-pressed="false">Todo</button>
